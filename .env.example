# =============================================================================
# VITORIUM — variaveis de ambiente (modelo)
# =============================================================================
# Copie para `.env` e ajuste os valores:  cp .env.example .env
# O arquivo `.env` real esta no .gitignore e NUNCA deve ser versionado.
# Os valores abaixo sao apenas defaults de desenvolvimento/demonstracao.
#
# O compose fica em docker/, entao passe o arquivo explicitamente:
#   docker compose --env-file .env -f docker/docker-compose.yml up --build -d
# (`make compose-up` ja faz isso quando o .env existe). Sem .env, o compose
# usa os defaults: VITORIUM_BACKEND=onnx, porta 8000, Grafana admin/admin.

# -----------------------------------------------------------------------------
# API de inferencia
# -----------------------------------------------------------------------------
# Backend de inferencia usado pelo /predict:
#   sklearn -> carrega models/model.joblib (pipeline TF-IDF + LogisticRegression)
#   onnx    -> carrega models/model.onnx via onnxruntime (menor latencia)
# Lido pelo servico `api` do compose (default: onnx). Se o model.onnx nao
# carregar, a API cai para sklearn e o /health mostra o backend em uso.
VITORIUM_BACKEND=onnx

# Porta HTTP da API (uvicorn escuta em 8000 dentro do container; o compose
# publica 8000:8000 no host).
VITORIUM_API_PORT=8000

# -----------------------------------------------------------------------------
# Grafana (servico `grafana` do docker/docker-compose.yml)
# -----------------------------------------------------------------------------
# Credenciais do usuario administrador. O compose de demonstracao usa
# admin/admin; em qualquer ambiente compartilhado troque por um segredo forte.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=troque-esta-senha
