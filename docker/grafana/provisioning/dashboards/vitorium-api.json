{
  "title": "VITORIUM API",
  "uid": "vitorium-api",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Total de Requisicoes (todas as rotas)",
      "description": "Soma de todas as rotas (/predict, /health, /metrics...). Nao e o numero de predicoes.",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(vitorium_requests_total)",
          "legendFormat": "requests"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latencia p95 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vitorium_request_latency_seconds_bucket[1m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Taxa de Erro do /predict (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "100 * (sum(rate(vitorium_requests_total{job=\"vitorium-api\",endpoint=\"/predict\",status_code=~\"5..\"}[5m])) or vector(0)) / sum(rate(vitorium_requests_total{job=\"vitorium-api\",endpoint=\"/predict\"}[5m]))",
          "legendFormat": "5xx / total do /predict"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requisicoes por Segundo",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(vitorium_requests_total[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Predicoes por Classe de Urgencia",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(vitorium_predictions_total) by (urgencia)",
          "legendFormat": "{{urgencia}}"
        }
      ]
    }
  ]
}
